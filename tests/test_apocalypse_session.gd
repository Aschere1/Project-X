class_name ApocalypseSessionTests
extends RefCounted

const GAME_RULES_SCRIPT = preload("res://src/domain/session/game_rules.gd")
const APOCALYPSE_SESSION_SCRIPT = preload("res://src/domain/apocalypse/apocalypse_session.gd")
const SEARCH_CONTAINER_SCRIPT = preload("res://src/domain/apocalypse/search_container.gd")

static func run(test: Variant) -> void:
	var rules := GAME_RULES_SCRIPT.new()
	var session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	session.start_new_game(rules, {"observation": 1})

	test.expect_equal(session.get_timeline_kind(), &"apocalypse", "A new session uses the apocalypse timeline kind")
	test.expect_equal(session.get_day(), 1, "A new apocalypse session starts on day one")
	test.expect_equal(session.get_clock_text(), "06:00", "A new apocalypse session starts at six in the morning")
	test.expect_equal(session.get_survivor_snapshot()["attributes"]["observation"], 1, "The session keeps the survivor profile")
	test.expect_equal(session.get_region_threat(&"county_edge"), 0, "The starting region begins with low threat")
	test.expect_true(session.place_item_in_container(&"backpack", &"water_1", &"water", 1, 1, 5), "The session can place a carried item in the backpack")
	test.expect_equal(session.get_container_total_weight(&"backpack"), 5, "The session owns carried backpack weight")
	test.expect_equal(session.get_container_total_weight(&"home_storage"), 0, "A new session starts with an empty home storage container")
	test.expect_true(session.transfer_item(&"backpack", &"home_storage", &"water_1"), "A carried item can move into persistent home storage")
	test.expect_equal(session.get_container_total_weight(&"backpack"), 0, "A transfer removes the item from the source container")
	test.expect_equal(session.get_container_total_weight(&"home_storage"), 5, "A transfer adds the item to the home storage container")
	test.expect_true(session.transfer_item(&"home_storage", &"backpack", &"water_1"), "A stored item can move back into the backpack")
	test.expect_true(not session.transfer_item(&"backpack", &"backpack", &"water_1"), "A transfer rejects the same source and destination container")
	test.expect_true(session.place_item_in_container(&"backpack", &"water_1", &"water", 1, 1, 5), "A second copy of the same supply item can enter the backpack")
	var carried_water: Array[Dictionary] = session.get_container_items(&"backpack")
	test.expect_equal(carried_water.size(), 1, "Two copies of one supply item occupy one backpack cell")
	if not carried_water.is_empty():
		test.expect_equal(carried_water[0]["quantity"], 2, "The supply stack records its total quantity")
		test.expect_equal(carried_water[0]["maximum_stack"], 16, "Ordinary supplies use the configured stack limit of sixteen")
	test.expect_equal(session.get_container_total_weight(&"backpack"), 10, "Backpack weight counts every item inside a stack")
	test.expect_true(session.transfer_quantity(&"backpack", &"home_storage", &"water_1", 1), "One item can transfer out of a supply stack")
	test.expect_equal(session.get_container_items(&"backpack")[0]["quantity"], 1, "A partial transfer decrements only the source stack")
	test.expect_equal(session.get_container_items(&"home_storage")[0]["quantity"], 1, "A partial transfer creates the requested target quantity")
	var partial_home_stack_id := StringName(session.get_container_items(&"home_storage")[0]["instance_id"])
	test.expect_true(session.transfer_quantity(&"home_storage", &"backpack", partial_home_stack_id, 1), "One stored item can transfer back into a matching backpack stack")
	test.expect_equal(session.get_container_items(&"backpack")[0]["quantity"], 2, "A partial return fills the existing matching backpack stack")
	test.expect_true(session.place_item_in_container(&"backpack", &"water_more", &"water", 1, 1, 5, true, 2), "Extra supplies can be added before splitting a stack")
	test.expect_true(session.split_item_stack(&"backpack", &"water_1", 2), "A backpack stack can split into two stacks")
	test.expect_equal(session.get_container_items(&"backpack").size(), 2, "Splitting a stack consumes one additional backpack cell")
	test.expect_true(session.place_item_in_container(&"backpack", &"pistol_1", &"pistol", 1, 1, 4), "A first weapon can occupy a backpack cell")
	test.expect_true(session.place_item_in_container(&"backpack", &"pistol_2", &"pistol", 1, 1, 4), "A second weapon can occupy another backpack cell")
	var backpack_with_weapons: Array[Dictionary] = session.get_container_items(&"backpack")
	test.expect_equal(backpack_with_weapons.size(), 4, "Weapons remain separate from the two split supply stacks")

	test.expect_true(session.spend_action(30, 10), "An action spends time and stamina when both are available")
	test.expect_equal(session.get_clock_text(), "06:30", "An action advances the shared world clock")
	test.expect_equal(session.get_stamina(), 90, "An action reduces stamina")
	test.expect_true(not session.spend_action(30, 100), "An action is rejected when stamina is insufficient")
	test.expect_equal(session.get_clock_text(), "06:30", "A rejected action does not advance time")

	session.set_region_threat(&"county_edge", 2)
	test.expect_equal(session.get_region_threat(&"county_edge"), 2, "Regional threat is stored as a bounded level")
	test.expect_true(session.discover_location(&"village_clinic", &"fixed"), "A new location can be discovered")
	test.expect_true(not session.discover_location(&"village_clinic", &"fixed"), "A location is not discovered twice")
	test.expect_equal(session.get_location_snapshot(&"village_clinic")["state"], "known", "Discovered locations expose a stable state")
	var medicine_cabinet: Variant = SEARCH_CONTAINER_SCRIPT.new(&"clinic_medicine_cabinet", 2, 1)
	test.expect_true(medicine_cabinet.add_hidden_item(&"medkit_1", &"medkit", 1, 1, 1, 4, 1, 2, &"medical"), "A location search container can define hidden loot")
	medicine_cabinet.search_item(&"medkit_1")
	test.expect_true(session.store_location_search_container_snapshot(&"village_clinic", &"clinic_medicine_cabinet", medicine_cabinet.to_snapshot()), "A session persists a validated location search container snapshot")
	test.expect_equal(session.get_location_search_container_snapshot(&"village_clinic", &"clinic_medicine_cabinet")["state"], &"searched", "Location search progress is readable from the shared session")

	session.sleep()
	test.expect_equal(session.get_day(), 2, "Sleeping advances the apocalypse timeline")
	test.expect_equal(session.get_stamina(), 100, "Sleeping restores stamina")
	test.expect_equal(session.get_survivor_snapshot()["condition_levels"]["hunger"], 1, "Sleeping advances hunger pressure")
	test.expect_equal(session.get_survivor_snapshot()["condition_levels"]["thirst"], 1, "Sleeping advances thirst pressure")

	var backpack: Dictionary = session.get_container_snapshot(&"backpack")
	test.expect_equal(backpack["columns"], 6, "The apocalypse session provides a backpack grid")
	test.expect_equal(backpack["rows"], 4, "The backpack grid has a saved height")
	test.expect_equal(backpack["items"].size(), 4, "Two split supplies and two unstacked weapons are included in the session snapshot")

	var restored: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(restored.restore_snapshot(rules, session.to_snapshot()), "The apocalypse session restores from a pure snapshot")
	test.expect_equal(restored.get_timeline_kind(), &"apocalypse", "Restored sessions remain on the apocalypse timeline")
	test.expect_equal(restored.get_day(), 2, "Restored sessions keep the current day")
	test.expect_equal(restored.get_region_threat(&"county_edge"), 2, "Restored sessions keep regional threat")
	test.expect_true(restored.is_location_known(&"village_clinic"), "Restored sessions keep discovered locations")
	test.expect_equal(restored.get_location_search_container_snapshot(&"village_clinic", &"clinic_medicine_cabinet")["state"], &"searched", "Restored sessions keep location search progress")
	test.expect_equal(restored.get_container_total_weight(&"home_storage"), 0, "Restored sessions include the empty home storage container")

	var legacy_snapshot: Dictionary = session.to_snapshot()
	var legacy_containers: Dictionary = legacy_snapshot["containers"]
	legacy_containers.erase("home_storage")
	legacy_snapshot["containers"] = legacy_containers
	legacy_snapshot.erase("equipment")
	legacy_snapshot.erase("campaign")
	var legacy_restored: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(legacy_restored.restore_snapshot(rules, legacy_snapshot), "A pre-storage apocalypse snapshot remains restorable")
	test.expect_equal(legacy_restored.get_container_total_weight(&"home_storage"), 0, "Legacy snapshots receive an empty home storage container")
	test.expect_equal(legacy_restored.get_equipped_weapon_snapshot()["display_name"], "空手", "A pre-equipment snapshot restores with an empty weapon slot")

	var equipment_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	equipment_session.start_new_game(rules)
	test.expect_true(equipment_session.place_item_in_container(&"backpack", &"crowbar_equip", &"crowbar", 1, 1, 3), "A crowbar can occupy one unstacked backpack cell")
	test.expect_equal(equipment_session.get_container_items(&"backpack")[0]["maximum_stack"], 1, "Weapons cannot stack like ordinary supplies")
	var equip_result: Dictionary = equipment_session.equip_weapon(&"crowbar_equip")
	test.expect_true(bool(equip_result.get("ok", false)), "A carried crowbar can be equipped as the main weapon")
	test.expect_equal(equipment_session.get_equipped_weapon_snapshot()["damage"], 8, "The equipped crowbar exposes its concrete melee damage")
	var restored_equipment_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(restored_equipment_session.restore_snapshot(rules, equipment_session.to_snapshot()), "The equipped weapon survives a session snapshot")
	test.expect_equal(restored_equipment_session.get_equipped_weapon_snapshot()["item_id"], &"crowbar", "The restored equipment slot still references the carried crowbar")
	test.expect_true(restored_equipment_session.transfer_item(&"backpack", &"home_storage", &"crowbar_equip"), "An equipped weapon can be stored without becoming stuck")
	test.expect_equal(restored_equipment_session.get_equipped_weapon_snapshot()["display_name"], "空手", "Storing an equipped weapon automatically clears the equipment slot")

	var usable_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	usable_session.start_new_game(rules)
	usable_session.sleep()
	test.expect_true(usable_session.place_item_in_container(&"backpack", &"water_use", &"water", 1, 1, 5, true, 2), "A usable water stack can be placed in a backpack")
	var drink_result: Dictionary = usable_session.use_item_in_container(&"backpack", &"water_use")
	test.expect_true(bool(drink_result.get("ok", false)), "Drinking water succeeds when thirst is above zero")
	test.expect_equal(usable_session.get_survivor_snapshot()["condition_levels"]["thirst"], 0, "Drinking removes one thirst level")
	test.expect_equal(usable_session.get_container_items(&"backpack")[0]["quantity"], 1, "Drinking consumes exactly one stacked water bottle")
	test.expect_equal(usable_session.get_clock_text(), "06:05", "Using a supply consumes the documented five minutes")
	var dry_drink_result: Dictionary = usable_session.use_item_in_container(&"backpack", &"water_use")
	test.expect_true(not bool(dry_drink_result.get("ok", false)), "Water is not wasted while the survivor has no thirst")
	test.expect_equal(usable_session.get_container_items(&"backpack")[0]["quantity"], 1, "A rejected drink does not consume its item")
	usable_session.apply_survivor_damage(30)
	test.expect_true(usable_session.place_item_in_container(&"backpack", &"medkit_use", &"medkit", 1, 1, 4), "A medical kit can be placed for use")
	var medkit_result: Dictionary = usable_session.use_item_in_container(&"backpack", &"medkit_use")
	test.expect_true(bool(medkit_result.get("ok", false)), "A medical kit succeeds when health is below maximum")
	test.expect_equal(usable_session.get_survivor_snapshot()["health"], 95, "A medical kit restores up to twenty-five health")
	test.expect_true(not usable_session.get_container_items(&"backpack").any(func(item: Dictionary) -> bool: return StringName(item["instance_id"]) == &"medkit_use"), "Using a medical kit removes its one consumed item")
	test.expect_true(usable_session.add_survivor_injury(&"bleeding"), "The use test can add a treatable injury")
	test.expect_true(usable_session.place_item_in_container(&"backpack", &"bandage_use", &"bandage", 1, 1, 1), "A bandage can be placed for use")
	var bandage_result: Dictionary = usable_session.use_item_in_container(&"backpack", &"bandage_use")
	test.expect_true(bool(bandage_result.get("ok", false)), "A bandage succeeds when the survivor has an injury")
	test.expect_equal(usable_session.get_survivor_snapshot()["injuries"].size(), 0, "A bandage removes one current injury")
	test.expect_true(not usable_session.get_container_items(&"backpack").any(func(item: Dictionary) -> bool: return StringName(item["instance_id"]) == &"bandage_use"), "Using a bandage removes its one consumed item")

	var lock_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	lock_session.start_new_game(rules)
	lock_session.discover_location(&"village_clinic", &"fixed")
	test.expect_true(not lock_session.is_location_lock_unlocked(&"village_clinic", &"clinic_locked_cabinet"), "A new clinic lock starts locked")
	var missing_key_result: Dictionary = lock_session.unlock_location_lock(&"village_clinic", &"clinic_locked_cabinet", &"clinic_key", 5)
	test.expect_true(not bool(missing_key_result.get("ok", false)), "A locked cabinet rejects unlock attempts without its key")
	test.expect_equal(lock_session.get_clock_text(), "06:00", "A rejected unlock does not advance time")
	test.expect_true(lock_session.place_item_in_container(&"backpack", &"clinic_key_use", &"clinic_key", 1, 1, 1), "A clinic key can be carried to the lock")
	var unlock_result: Dictionary = lock_session.unlock_location_lock(&"village_clinic", &"clinic_locked_cabinet", &"clinic_key", 5)
	test.expect_true(bool(unlock_result.get("ok", false)), "A carried clinic key unlocks the clinic cabinet")
	test.expect_true(lock_session.is_location_lock_unlocked(&"village_clinic", &"clinic_locked_cabinet"), "A successful unlock persists in the active location state")
	test.expect_equal(lock_session.get_clock_text(), "06:05", "Unlocking a cabinet consumes five minutes")
	test.expect_equal(lock_session.get_container_items(&"backpack")[0]["quantity"], 1, "Unlocking keeps the durable clinic key in the backpack")
	var restored_lock_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(restored_lock_session.restore_snapshot(rules, lock_session.to_snapshot()), "A lock state survives an apocalypse session snapshot")
	test.expect_true(restored_lock_session.is_location_lock_unlocked(&"village_clinic", &"clinic_locked_cabinet"), "A restored session keeps the unlocked clinic cabinet")

	var generator_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	generator_session.start_new_game(rules)
	var missing_fuel_result: Dictionary = generator_session.refuel_home_generator()
	test.expect_true(not bool(missing_fuel_result.get("ok", false)), "A generator cannot refuel without a home-stored fuel can")
	test.expect_equal(generator_session.get_home_power(), 0, "A rejected refuel leaves home power unchanged")
	test.expect_true(generator_session.place_item_in_container(&"backpack", &"fuel_generator", &"fuel_can", 1, 1, 6), "A fuel can can be carried back from exploration")
	test.expect_true(generator_session.transfer_item(&"backpack", &"home_storage", &"fuel_generator"), "A fuel can can be stored at home before generator use")
	var refuel_result: Dictionary = generator_session.refuel_home_generator()
	test.expect_true(bool(refuel_result.get("ok", false)), "A home-stored fuel can refuels the emergency generator")
	test.expect_equal(generator_session.get_home_power(), 10, "One fuel can adds the catalogued ten home-power units")
	test.expect_equal(generator_session.get_clock_text(), "06:05", "Generator refuelling consumes five minutes")
	test.expect_equal(generator_session.get_container_item_quantity(&"home_storage", &"fuel_can"), 0, "Refuelling consumes one fuel can from home storage")
	var restored_generator_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(restored_generator_session.restore_snapshot(rules, generator_session.to_snapshot()), "Home power survives an apocalypse session snapshot")
	test.expect_equal(restored_generator_session.get_home_power(), 10, "A restored session keeps the generator power reserve")
	test.expect_true(generator_session.place_item_in_container(&"home_storage", &"medkit_station", &"medkit", 1, 1, 4), "A home-stored medical kit can supply the medical station")
	test.expect_true(generator_session.add_survivor_injury(&"laceration"), "The medical-station test starts with a treatable injury")
	generator_session.add_survivor_infection_risk(20)
	var medical_result: Dictionary = generator_session.treat_at_home_medical_station()
	test.expect_true(bool(medical_result.get("ok", false)), "The powered medical station treats a survivor with a stored medical kit")
	test.expect_equal(generator_session.get_home_power(), 0, "Medical treatment consumes ten home-power units")
	test.expect_equal(generator_session.get_clock_text(), "06:20", "Medical treatment consumes fifteen shared-world minutes")
	test.expect_equal(generator_session.get_container_item_quantity(&"home_storage", &"medkit"), 0, "Medical treatment consumes one home-stored medical kit")
	test.expect_equal(generator_session.get_survivor_snapshot()["injuries"].size(), 0, "Medical treatment removes one injury")
	test.expect_equal(generator_session.get_survivor_snapshot()["infection_risk"], 5, "Medical treatment reduces infection risk by fifteen")
	var unpowered_medical_result: Dictionary = generator_session.treat_at_home_medical_station()
	test.expect_true(not bool(unpowered_medical_result.get("ok", false)), "Medical treatment is rejected when its power reserve is empty")
	test.expect_true(generator_session.place_item_in_container(&"home_storage", &"fuel_workbench", &"fuel_can", 1, 1, 6), "A fuel can can refill power for a workbench recipe")
	test.expect_true(bool(generator_session.refuel_home_generator().get("ok", false)), "The workbench test can restore ten home-power units")
	test.expect_true(generator_session.place_item_in_container(&"home_storage", &"scrap_workbench", &"scrap_metal", 1, 1, 1), "Scrap metal can be stored for the workbench recipe")
	test.expect_true(generator_session.place_item_in_container(&"home_storage", &"wire_workbench", &"wire", 1, 1, 1), "Wire can be stored for the workbench recipe")
	var craft_result: Dictionary = generator_session.craft_simple_lockpick()
	test.expect_true(bool(craft_result.get("ok", false)), "The powered workbench crafts a simple lockpick from its two materials")
	test.expect_equal(generator_session.get_home_power(), 5, "Crafting consumes five home-power units")
	test.expect_equal(generator_session.get_clock_text(), "06:35", "Crafting consumes ten shared-world minutes after the refuel")
	test.expect_equal(generator_session.get_container_item_quantity(&"home_storage", &"scrap_metal"), 0, "Crafting consumes one scrap-metal material")
	test.expect_equal(generator_session.get_container_item_quantity(&"home_storage", &"wire"), 0, "Crafting consumes one wire material")
	test.expect_equal(generator_session.get_container_item_quantity(&"home_storage", &"simple_lockpick"), 1, "Crafting creates one stored simple lockpick")

	var lockpick_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	lockpick_session.start_new_game(rules)
	lockpick_session.discover_location(&"village_clinic", &"fixed")
	test.expect_true(lockpick_session.place_item_in_container(&"backpack", &"lockpick_use", &"simple_lockpick", 1, 1, 1), "A crafted lockpick can be carried back to a locked clinic cabinet")
	var lockpick_unlock_result: Dictionary = lockpick_session.unlock_location_lock_with_item(&"village_clinic", &"clinic_locked_cabinet", &"simple_lockpick", 10, true)
	test.expect_true(bool(lockpick_unlock_result.get("ok", false)), "A simple lockpick can unlock the clinic cabinet without its durable key")
	test.expect_equal(lockpick_session.get_clock_text(), "06:10", "The consumable lockpick route takes ten minutes")
	test.expect_equal(lockpick_session.get_container_item_quantity(&"backpack", &"simple_lockpick"), 0, "Unlocking with a simple lockpick consumes the crafted tool")

	var noise_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	noise_session.start_new_game(rules)
	noise_session.discover_location(&"village_clinic", &"fixed")
	var quiet_noise_result: Dictionary = noise_session.record_location_search_noise(&"village_clinic", 2)
	test.expect_true(bool(quiet_noise_result.get("ok", false)), "Search noise records against a known location")
	test.expect_equal(noise_session.get_location_search_noise(&"village_clinic"), 2, "A quiet search accumulates its exact location noise")
	test.expect_equal(noise_session.get_region_threat(&"county_edge"), 0, "Noise below the warning threshold does not raise regional threat")
	var warning_noise_result: Dictionary = noise_session.record_location_search_noise(&"village_clinic", 3)
	test.expect_true(bool(warning_noise_result.get("threat_increased", false)), "Crossing the warning threshold raises regional threat once")
	test.expect_equal(noise_session.get_region_threat(&"county_edge"), 1, "Five accumulated noise raises the current region threat by one")
	var danger_noise_result: Dictionary = noise_session.record_location_search_noise(&"village_clinic", 5)
	test.expect_true(bool(danger_noise_result.get("dangerous", false)), "Ten accumulated noise marks the location as dangerous to continue searching")
	test.expect_true(noise_session.is_location_search_dangerous(&"village_clinic"), "The session exposes a stable dangerous-search condition")
	var restored_noise_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(restored_noise_session.restore_snapshot(rules, noise_session.to_snapshot()), "Location noise survives an apocalypse session snapshot")
	test.expect_equal(restored_noise_session.get_location_search_noise(&"village_clinic"), 10, "A restored session keeps its accumulated location noise")
	test.expect_true(restored_noise_session.is_location_search_dangerous(&"village_clinic"), "A restored session keeps the dangerous-search condition")

	var prepared_raid_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	prepared_raid_session.start_new_game(rules)
	test.expect_equal(prepared_raid_session.get_campaign_snapshot()["score"], 0, "A new campaign starts with no first-raid preparation completed")
	test.expect_true(prepared_raid_session.place_item_in_container(&"home_storage", &"raid_fuel", &"fuel_can", 1, 1, 6), "Raid preparation can store one generator fuel can")
	test.expect_true(bool(prepared_raid_session.refuel_home_generator().get("ok", false)), "Raid preparation can raise home power to ten")
	test.expect_true(prepared_raid_session.place_item_in_container(&"home_storage", &"raid_medkit", &"medkit", 1, 1, 4), "Raid preparation can store one medical kit")
	test.expect_true(prepared_raid_session.place_item_in_container(&"backpack", &"raid_crowbar", &"crowbar", 1, 1, 3), "Raid preparation can carry one weapon")
	test.expect_equal(prepared_raid_session.get_campaign_snapshot()["score"], 3, "Power, a home medical kit, and a weapon complete all three visible preparations")
	var first_rest_result: Dictionary = prepared_raid_session.rest_at_shelter()
	test.expect_true(not bool(first_rest_result.get("raid_resolved", false)), "The first night advances the campaign without resolving the raid early")
	prepared_raid_session.rest_at_shelter()
	var held_raid_result: Dictionary = prepared_raid_session.rest_at_shelter()
	test.expect_true(bool(held_raid_result.get("raid_resolved", false)), "Resting into day four resolves the first raid")
	test.expect_equal(prepared_raid_session.get_day(), 4, "The first raid resolves at the documented day-four dawn")
	test.expect_equal(prepared_raid_session.get_campaign_snapshot()["outcome"], &"held", "Two or more preparations hold the first raid")
	test.expect_equal(prepared_raid_session.get_campaign_snapshot()["score"], 3, "The resolved campaign preserves the readiness score used for settlement")
	test.expect_equal(prepared_raid_session.get_home_power(), 5, "The first raid consumes five available home-power units")
	var restored_raid_session: Variant = APOCALYPSE_SESSION_SCRIPT.new()
	test.expect_true(restored_raid_session.restore_snapshot(rules, prepared_raid_session.to_snapshot()), "A resolved first raid survives a session snapshot")
	test.expect_equal(restored_raid_session.get_campaign_snapshot()["outcome"], &"held", "A restored campaign keeps its settled first-raid outcome")
	var day_five_trigger: Dictionary = prepared_raid_session.rest_at_shelter()
	test.expect_true(bool(day_five_trigger.get("event_pending", false)), "Resting into day five creates one pending campaign event")
	test.expect_equal(prepared_raid_session.get_day(), 5, "The radio event triggers at the documented day-five dawn")
	var pending_radio_event: Dictionary = prepared_raid_session.get_pending_campaign_event()
	test.expect_equal(pending_radio_event.get("event_id", &""), &"day_five_radio_signal", "The day-five event exposes a stable event ID")
	var radio_choices: Array = pending_radio_event.get("choices", [])
	test.expect_equal(radio_choices.size(), 2, "The radio event exposes exactly two authored choices")
	test.expect_true(bool(radio_choices[0].get("available", false)), "Five remaining power makes the listening choice available")
	var blocked_day_five_rest: Dictionary = prepared_raid_session.rest_at_shelter()
	test.expect_true(not bool(blocked_day_five_rest.get("ok", true)), "A pending campaign event blocks another overnight rest")
	test.expect_equal(prepared_raid_session.get_day(), 5, "Blocked rest does not skip past the unresolved day-five event")
