extends SceneTree

const TestHarness = preload("res://tests/test_harness.gd")
const GameSessionTests = preload("res://tests/test_game_session.gd")
const SaveRepositoryTests = preload("res://tests/test_save_repository.gd")
const InventoryTests = preload("res://tests/test_inventory.gd")
const FarmPlotTests = preload("res://tests/test_farm_plot.gd")
const WorldCollisionTests = preload("res://tests/test_world_collision.gd")
const HomeInteriorTests = preload("res://tests/test_home_interior.gd")
const CropCatalogTests = preload("res://tests/test_crop_catalog.gd")
const SeedSelectionTests = preload("res://tests/test_seed_selection.gd")
const CookingEngineTests = preload("res://tests/test_cooking_engine.gd")
const FoodSourceTests = preload("res://tests/test_food_sources.gd")
const ChickenCoopTests = preload("res://tests/test_chicken_coop.gd")
const HomeRegionTests = preload("res://tests/test_home_region.gd")
const PlayerMovementTests = preload("res://tests/test_player_movement.gd")
const HomeMultidayTests = preload("res://tests/test_home_multiday.gd")
const FarmSoilVisualReviewTests = preload("res://tests/test_farm_soil_visual_review.gd")
const ChickenCoopVisualReviewTests = preload("res://tests/test_chicken_coop_visual_review.gd")
const D20CheckTests = preload("res://tests/test_d20_check.gd")
const SurvivorStateTests = preload("res://tests/test_survivor_state.gd")
const GridContainerTests = preload("res://tests/test_grid_container.gd")
const ApocalypseSessionTests = preload("res://tests/test_apocalypse_session.gd")
const ApocalypseShelterFacilitiesTests = preload("res://tests/test_apocalypse_shelter_facilities.gd")
const ApocalypseRunTests = preload("res://tests/test_apocalypse_run.gd")
const ApocalypseEntryTests = preload("res://tests/test_apocalypse_entry.gd")
const SearchContainerTests = preload("res://tests/test_search_container.gd")
const ApocalypseExploreVisualReviewTests = preload("res://tests/test_apocalypse_explore_visual_review.gd")
const ApocalypseShelterVisualReviewTests = preload("res://tests/test_apocalypse_shelter_visual_review.gd")
const ApocalypseRegionMapVisualReviewTests = preload("res://tests/test_apocalypse_region_map_visual_review.gd")
const ApocalypseStorageVisualReviewTests = preload("res://tests/test_apocalypse_storage_visual_review.gd")
const ApocalypseMarketVisualReviewTests = preload("res://tests/test_apocalypse_market_visual_review.gd")
const ApocalypseWarehouseVisualReviewTests = preload("res://tests/test_apocalypse_warehouse_visual_review.gd")
const ApocalypseDayFiveEventVisualReviewTests = preload("res://tests/test_apocalypse_day_five_event_visual_review.gd")
const ApocalypseDaySixEventVisualReviewTests = preload("res://tests/test_apocalypse_day_six_event_visual_review.gd")
const ApocalypseDaySevenEventVisualReviewTests = preload("res://tests/test_apocalypse_day_seven_event_visual_review.gd")
const ApocalypseHouseInteriorVisualReviewTests = preload("res://tests/test_apocalypse_house_interior_visual_review.gd")

func _init() -> void:
	call_deferred(&"_run_tests")


func _run_tests() -> void:
	var test := TestHarness.new()
	GameSessionTests.run(test)
	SaveRepositoryTests.run(test)
	InventoryTests.run(test)
	FarmPlotTests.run(test)
	WorldCollisionTests.run(test)
	HomeInteriorTests.run(test)
	CropCatalogTests.run(test)
	SeedSelectionTests.run(test)
	CookingEngineTests.run(test)
	FoodSourceTests.run(test)
	ChickenCoopTests.run(test)
	HomeRegionTests.run(test)
	ChickenCoopVisualReviewTests.run(test)
	PlayerMovementTests.run(test)
	HomeMultidayTests.run(test)
	FarmSoilVisualReviewTests.run(test)
	D20CheckTests.run(test)
	SurvivorStateTests.run(test)
	GridContainerTests.run(test)
	ApocalypseSessionTests.run(test)
	ApocalypseShelterFacilitiesTests.run(test)
	ApocalypseRunTests.run(test)
	ApocalypseEntryTests.run(test)
	SearchContainerTests.run(test)
	ApocalypseStorageVisualReviewTests.run(test)
	ApocalypseRegionMapVisualReviewTests.run(test)
	ApocalypseMarketVisualReviewTests.run(test)
	ApocalypseWarehouseVisualReviewTests.run(test)
	ApocalypseExploreVisualReviewTests.run(test)
	ApocalypseDayFiveEventVisualReviewTests.run(test)
	ApocalypseDaySixEventVisualReviewTests.run(test)
	ApocalypseDaySevenEventVisualReviewTests.run(test)
	ApocalypseHouseInteriorVisualReviewTests.run(test)
	ApocalypseShelterVisualReviewTests.run(test)

	if test.failures.is_empty():
		print("TESTS_PASSED assertions=%d" % test.assertion_count)
		quit(0)
		return

	for failure in test.failures:
		print("TEST_FAILED: %s" % failure)
		push_error("TEST_FAILED: %s" % failure)
	print("TESTS_FAILED count=%d" % test.failures.size())
	quit(1)
